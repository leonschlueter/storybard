# Overridden by docker-compose.yml when running in Docker; this is for running the
# server directly on the host instead.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/storybard

# LM Studio local server (Settings > Local Server > Start, or `lms server start`).
# When running via docker compose, this is overridden to http://host.docker.internal:1234/v1.
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Must exactly match a model id LM Studio has loaded — check with:
#   curl http://localhost:1234/v1/models
LLM_MODEL_DEFAULT=google/gemma-4-e4b
# Used only for the chain's judgment-heavy nodes (opportunity spotting, plan synthesis,
# world update) — a bigger/slower model that reliably commits structural changes where the
# fast default model tends to stay too conservative. See chain/graph.py's
# CREATIVE_NODE_TYPES.
LLM_MODEL_CREATIVE=qwen/qwen3.8-27b
LM_STUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

LOG_LEVEL=INFO
