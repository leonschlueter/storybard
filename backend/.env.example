# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/storybard

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# LLM models (empty => fall back to LLM_MODEL_DEFAULT)
LLM_MODEL_DEFAULT=mistral
LLM_MODEL_INTENT=
LLM_MODEL_CHECK=
LLM_MODEL_KNOWLEDGE=
LLM_MODEL_GM=
LLM_MODEL_NARRATOR=
LLM_MODEL_MEMORY=
LLM_MODEL_THREAD=
LLM_MODEL_SEEDER=

# Dev
DB_AUTOCREATE=true

# Observability
LOG_LEVEL=INFO

# Optional OpenTelemetry OTLP exporter
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=storybard-engine
